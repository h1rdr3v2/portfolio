{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./resources/js/*"]
		}
	},
	"include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "vite.config.ts"]
}
